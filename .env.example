# MongoDB Atlas connection string (Mumbai cluster recommended for lowest latency)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/idliandmore?retryWrites=true&w=majority

# Jose JWT Secret for edge-compatible token encryption
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_idli_bhopal_2026

# Seed Owner Credentials (used by `npm run seed`)
ADMIN_EMAIL=owner@idliandmore.in
ADMIN_PASSWORD=IdliTempleMorning2026!

# Vercel Blob Read/Write Token for Direct Image Uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_placeholder

# Vercel Cron Secret (passed as Authorization: Bearer <secret> or CRON_SECRET header)
CRON_SECRET=idli_cron_secret_bhopal_safe

# Public Site URL (canonical domain, used for QR generation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay / UPI Integration (optional feature flag)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
